{
  "name": "database-schema-data-extraction-2026-06-03",
  "version": "0.7.2",
  "description": "",
  "type": "module",
  "scripts": {
    "build:db": "npx tsx scripts/create_db.ts",
    "build:er": "npx tsx scripts/render_er_svg.ts",
    "build:schema": "npx tsx scripts/extract_descriptions.ts",
    "build:js": "esbuild src/app.ts --outfile=public/app.js --platform=browser --target=es2020 --minify",
    "build:css": "esbuild public/style.css --outfile=public/style.min.css --minify 2>&1",
    "build:gz": "npx tsx scripts/gzip_assets.ts",
    "build": "cp VERSION public/VERSION && npm run build:db && npm run build:er && npm run build:schema && npm run typecheck && npm run build:js && npm run build:css && npm run build:gz",
    "start": "npm run build && npx http-server public -p 3000 -c-1 --cors -g",
    "dev": "npx http-server public -p 3000 -c-1 --cors -g",
    "test": "npx tsx judge.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Tran Van Tan Khoi",
  "license": "ISC",
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
